}
function add(dst, src) {
  dst.input += src.input;
  dst.output += src.output;
  dst.cacheRead += src.cacheRead;
  dst.cacheCreate += src.cacheCreate;
  dst.calls += src.calls;
}
function bucketFor(ts) {
  const buckets = ["all"];
  if (ts >= sevenDaysMs) buckets.push("7d");
  if (ts >= todayMs) buckets.push("today");
  return buckets;
}
function collectJsonl(dir, maxDepth = 10) {
  const files = [];
  function walk(current, depth) {
    if (depth > maxDepth) return;
    for (const entry of readDir(current)) {
      const full = path.join(current, entry.name);
      if (entry.isDirectory()) walk(full, depth + 1);
      else if (entry.isFile() && entry.name.endsWith(".jsonl")) files.push(full);
    }
  }
  walk(dir, 0);
  return files;
}
