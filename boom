    for (const bucket of bucketFor(row.ts)) add(result[bucket], row);
    const model = row.model || "unknown";
    if (!result.models.has(model)) result.models.set(model, empty());
    add(result.models.get(model), row);
  }
  return result;
}
function printSummary(title, rows, filesScanned) {
