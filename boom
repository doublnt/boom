const now = Date.now();
const dayStart = new Date();
dayStart.setHours(0, 0, 0, 0);
const todayMs = dayStart.getTime();
const sevenDaysMs = now - 7 * 24 * 60 * 60 * 1000;

function readDir(dir) {
  try { return fs.readdirSync(dir, { withFileTypes: true }); } catch { return []; }
