local_plugins() {
  local sync_pid sync_status
  BOOM_REAL_CLAUDE="$REAL_CLAUDE" BOOM_REAL_CODEX="$REAL_CODEX" node - "$BOOM_HOME/local-plugins.json" "$@" <<'NODE' &
const fs = require("fs");
const path = require("path");
const {spawn} = require("child_process");
const [registryPath, mode, ...args] = process.argv.slice(2);
function load() {
  if (!fs.existsSync(registryPath)) return {schema_version: 1, plugins: {}};
  const data = JSON.parse(fs.readFileSync(registryPath, "utf8"));
  if (data.schema_version !== 1 || !data.plugins || typeof data.plugins !== "object" || Array.isArray(data.plugins)) throw new Error("invalid local plugin registry");
  return data;
}
function save(data) {
  fs.mkdirSync(path.dirname(registryPath), {recursive: true, mode: 0o700});
  const temp = `${registryPath}.${process.pid}.tmp`;
  try {
    fs.writeFileSync(temp, `${JSON.stringify(data, null, 2)}\n`, {mode: 0o600, flag: "wx"});
    fs.renameSync(temp, registryPath);
  } finally { if (fs.existsSync(temp)) fs.unlinkSync(temp); }
}
function identity(source) {
  return JSON.parse(fs.readFileSync(path.join(source, ".claude-plugin/plugin.json"), "utf8")).name;
}
function adapter(source) {
  const script = fs.realpathSync(path.join(source, "scripts/sync-local-plugins.py"));
  const relative = path.relative(source, script);
  if (relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative) || !fs.statSync(script).isFile()) throw new Error("sync adapter must be a file inside the registered repository");
  return script;
}
let child = null;
function terminate(signal = "SIGTERM", pid = child?.pid) {
  if (pid) { try { process.kill(-pid, signal); } catch (error) { if (error.code !== "ESRCH") throw error; } }
}
for (const [signal, code] of [["SIGINT", 130], ["SIGTERM", 143]]) {
  process.on(signal, () => { const pid = child?.pid; terminate("SIGTERM", pid); setTimeout(() => { terminate("SIGKILL", pid); process.exit(code); }, 2000); });
}
async function ensure(script, tool, home) {
  return new Promise((resolve, reject) => {
    const env = {...process.env, [tool === "codex" ? "CODEX_HOME" : "CLAUDE_CONFIG_DIR"]: home};
    child = spawn("python3", [script, "--target", tool, "--ensure"], {env, detached: true, stdio: ["ignore", "pipe", "inherit"]});
    let output = "", expired = false;
    let killTimer;
    const timer = setTimeout(() => {
      expired = true; const pid = child?.pid; terminate("SIGTERM", pid);
      killTimer = setTimeout(() => terminate("SIGKILL", pid), 2000);
    }, 120000);
    child.stdout.on("data", chunk => {
      output += chunk;
      if (output.length > 1024 * 1024) { expired = true; terminate("SIGKILL"); }
    });
    const clear = () => { clearTimeout(timer); if (!expired) clearTimeout(killTimer); child = null; };
    child.on("error", error => { clear(); reject(error); });
    child.on("close", code => {
      clear();
      if (expired || code !== 0) return reject(new Error(expired ? "local plugin sync timed out" : `local plugin sync failed (exit ${code})`));
      try {
        const result = JSON.parse(output);
        if (result.schema_version !== 1 || result.status !== "ready" || typeof result.updated !== "boolean" || typeof result.version !== "string") throw new Error("invalid sync adapter response");
        resolve(result);
      } catch (error) { reject(error); }
    });
  });
}
async function main() {
  const data = load();
  if (mode === "add") {
    if (args.length !== 1) throw new Error("usage: boom plugins add <local-repository>");
    const source = fs.realpathSync(args[0]);
    const name = identity(source);
    if (typeof name !== "string" || !/^[a-z0-9][a-z0-9-]*$/.test(name)) throw new Error("invalid plugin name");
    adapter(source);
    data.plugins[name] = {source}; save(data);
    console.log(`Registered ${name}: ${source}\nLocal sync adapter will run before future launches.`);
  } else if (mode === "list") {
    if (args.length) throw new Error("usage: boom plugins list");
    for (const [name, entry] of Object.entries(data.plugins)) console.log(`${name}\t${entry.source}`);
  } else if (mode === "remove") {
    if (args.length !== 1 || !Object.hasOwn(data.plugins, args[0])) throw new Error("usage: boom plugins remove <registered-plugin-name>");
    delete data.plugins[args[0]]; save(data);
    console.log(`Stopped automatic sync for ${args[0]}. Installed copies are retained.`);
  } else if (mode === "ensure") {
    const [tool, home] = args;
    if (!["claude", "codex"].includes(tool) || !home || args.length !== 2) throw new Error("invalid sync target");
    for (const [name, entry] of Object.entries(data.plugins)) {
      const source = fs.realpathSync(entry.source);
      if (identity(source) !== name) throw new Error(`registered plugin identity changed: ${name}`);
      const result = await ensure(adapter(source), tool, home);
      if (result.updated) console.error(`boom: updated ${name} to ${result.version} in ${home}`);
    }
  } else throw new Error("usage: boom plugins add|list|remove");
}
main().catch(error => { console.error(`boom: ${error.message}`); process.exitCode = 1; });
NODE
  sync_pid=$!
  trap 'kill -TERM "$sync_pid" 2>/dev/null || true; wait "$sync_pid" 2>/dev/null || true; exit 143' TERM
  trap 'kill -INT "$sync_pid" 2>/dev/null || true; wait "$sync_pid" 2>/dev/null || true; exit 130' INT
  if wait "$sync_pid"; then sync_status=0; else sync_status=$?; fi
  trap - INT TERM
  return "$sync_status"
}

sync_local_plugins() {
  local tool="$1" home="$2" arg
  shift 2
  [ "${PARSED_PLUGIN_SYNC:-1}" -eq 1 ] || return 0
  [ -f "$BOOM_HOME/local-plugins.json" ] || return 0
  case "${1:-}" in
    plugin|plugins|auth|login|logout|completion|completions|app-server|mcp|mcp-server) return 0 ;;
  esac
  for arg in "$@"; do
    case "$arg" in --version|--help|-h|--ignore-user-config) return 0 ;; esac
  done
  local_plugins ensure "$tool" "$home"
}

parse_run_args() {
  PARSED_PROFILE=""
  PARSED_SAFE=1
  PARSED_NO_PROFILE=0
  PARSED_PLUGIN_SYNC=1
  PARSED_ARGS=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        shift
        PARSED_ARGS+=("$@")
        break
        ;;
      --safe)
        PARSED_SAFE=1
        ;;
      --unsafe)
        PARSED_SAFE=0
        ;;
      --no-profile)
        PARSED_NO_PROFILE=1
        ;;
      --no-plugin-sync)
        PARSED_PLUGIN_SYNC=0
        ;;
      -p|--profile)
        shift
        [ "$#" -gt 0 ] || die "$1 requires a name"
        PARSED_PROFILE="$1"
        ;;
      --profile=*)
        PARSED_PROFILE="${1#--profile=}"
        ;;
      -*)
        PARSED_ARGS+=("$1")
        ;;
      *)
        if [ -z "$PARSED_PROFILE" ]; then
          PARSED_PROFILE="$1"
        else
          PARSED_ARGS+=("$1")
        fi
        ;;
    esac
    shift || true
  done
}

run_claude() {
  local profile="$1"
  local safe="$2"
  local no_profile="$3"
  shift 3
  local args=()
  local profile_path

  [ -x "$REAL_CLAUDE" ] || die "real Claude not found: $REAL_CLAUDE"
  [ "$safe" -eq 1 ] || args+=("--dangerously-skip-permissions")
  args+=("$@")

  if [ "$no_profile" -eq 1 ]; then
    sync_local_plugins claude "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$@"
    exec "$REAL_CLAUDE" "${args[@]}"
  fi

  if [ -z "$profile" ]; then
    profile="$(get_default "$CLAUDE_DEFAULT")"
  fi

  if [ -z "$profile" ]; then
    sync_local_plugins claude "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$@"
    exec "$REAL_CLAUDE" "${args[@]}"
  fi

  if ! profile_path="$(resolve_claude_profile "$profile")"; then
    printf "Claude config '%s' does not exist.\n" "$profile" >&2
    print_missing_profiles claude
    exit 1
  fi

  sync_local_plugins claude "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$@"
  run_claude_with_settings "$profile_path" "${args[@]}"
}

run_codex() {
  local profile="$1"
  local safe="$2"
  local no_profile="$3"
  shift 3
  local args=()
  local profile_dir

  [ -x "$REAL_CODEX" ] || die "real Codex not found: $REAL_CODEX"
  [ "$safe" -eq 1 ] || args+=("--dangerously-bypass-approvals-and-sandbox")
  args+=("$@")

  if [ "$no_profile" -eq 1 ]; then
    sync_local_plugins codex "${CODEX_HOME:-$HOME/.codex}" "$@"
    exec "$REAL_CODEX" "${args[@]}"
  fi

  if [ -z "$profile" ]; then
    profile="$(get_default "$CODEX_DEFAULT")"
  fi

  if [ -z "$profile" ]; then
    sync_local_plugins codex "${CODEX_HOME:-$HOME/.codex}" "$@"
    exec "$REAL_CODEX" "${args[@]}"
  fi

  if ! profile_dir="$(resolve_codex_profile "$profile")"; then
    printf "Codex config '%s' does not exist.\n" "$profile" >&2
    print_missing_profiles codex
    exit 1
  fi

  sync_local_plugins codex "$profile_dir" "$@"
  # API-key profiles (boom codex add --api) supply the key via env_key in config.toml.
  if [ -f "$profile_dir/api_key" ]; then
    OPENAI_API_KEY="$(cat "$profile_dir/api_key")" CODEX_HOME="$profile_dir" exec "$REAL_CODEX" "${args[@]}"
  fi

  CODEX_HOME="$profile_dir" exec "$REAL_CODEX" "${args[@]}"
}

handle_tool() {
  local tool="$1"
  shift || true

  case "${1:-}" in
    profile)
      die "'profile' was removed. Use 'boom c list' or 'boom x list' instead."
      ;;
    help|--help|-h)
      usage
      exit 0
      ;;
  esac

  if [ "$tool" = "claude" ]; then
    case "${1:-}" in
      add|edit|show|list|ls|default|remove|rm|delete|doctor)
        handle_claude_profile_cmd "$@"
        exit $?
        ;;
    esac
  else
    case "${1:-}" in
      add|edit|list|ls|default|remove|rm|delete|doctor)
        handle_codex_profile_cmd "$@"
        exit $?
        ;;
    esac
  fi

  parse_run_args "$@"
  if [ "$tool" = "claude" ]; then
    run_claude "$PARSED_PROFILE" "$PARSED_SAFE" "$PARSED_NO_PROFILE" "${PARSED_ARGS[@]}"
  else
    run_codex "$PARSED_PROFILE" "$PARSED_SAFE" "$PARSED_NO_PROFILE" "${PARSED_ARGS[@]}"
  fi
}

# Remove Codex/Claude-internal files that are regenerated on the next launch,
# plus stray .DS_Store. Never touches sessions/history/state (shared), auth.json,
# or config.toml. Bounded depths so we never sweep into symlinked session trees.
boom_clean() {
  local dry_run=0
  local assume_yes=0
  local include_backups=0 include_staging=0
  local dir f size total
  local files=()
  local dirs=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --yes|-y) assume_yes=1 ;;
      --include-backups) include_backups=1 ;;
      --include-staging) include_staging=1 ;;
      --help|-h)
        printf 'Usage: boom clean [--dry-run] [--yes] [--include-backups] [--include-staging]\n'
        printf '  Selects Codex logs and .DS_Store under %s.\n' "$BOOM_HOME"
        printf '  Backups and staging directories are excluded unless explicitly selected.\n'
        return 0
        ;;
      *) die "unknown option for boom clean: $1" ;;
    esac
    shift || true
  done

  # find does not follow symlinks; NUL records preserve unusual path names.
  while IFS= read -r -d '' f; do
    [ -n "$f" ] && files+=("$f")
  done < <(find "$BOOM_HOME" -maxdepth 6 -name '.DS_Store' -type f -print0 2>/dev/null)

  # Per-profile regenerated cruft. Sessions/history/state are symlinks into
  # shared/ and find does not follow them, so they are never inspected.
  for dir in "$CODEX_PROFILES"/*; do
    [ -d "$dir" ] || continue
    [ ! -L "$dir" ] || continue
    # Codex logs: per-profile SQLite (each profile owns its own copy).
    for f in "$dir"/logs_2.sqlite "$dir"/logs_2.sqlite-shm "$dir"/logs_2.sqlite-wal; do
      [ -f "$f" ] && files+=("$f")
    done
    # Codex plugin sync staging (often hundreds of MB; fully rewritten on next launch).
    if [ "$include_staging" -eq 1 ] && [ -d "$dir/.tmp" ] && [ ! -L "$dir/.tmp" ]; then dirs+=("$dir/.tmp"); fi
    # Legacy config backups created by old boom codex edit invocations.
    while IFS= read -r -d '' f; do
      if [ "$include_backups" -eq 1 ] && [ -n "$f" ]; then files+=("$f"); fi
    done < <(find "$dir" -maxdepth 1 -name 'config.toml.bak.*' -type f -print0 2>/dev/null)
  done

  # Shared codex state backups + global-state tmp files. state_5.sqlite is
  # symlinked into each profile but the backups live in the shared root, so
  # we have to scan shared/ directly (per-profile glob is a no-op).
  while IFS= read -r -d '' f; do
    if [ "$include_backups" -eq 1 ] && [ -n "$f" ]; then files+=("$f"); fi
  done < <(find "$CODEX_SHARED" -maxdepth 1 -name 'state_5.sqlite.backup-*' -type f -print0 2>/dev/null)

  while IFS= read -r -d '' f; do
    if [ "$include_staging" -eq 1 ] && [ -n "$f" ]; then files+=("$f"); fi
  done < <(find "$CODEX_HOME_ROOT" -maxdepth 2 -name '..codex-global-state.json.tmp-*' -type f -print0 2>/dev/null)

  # Claude side: legacy backups of common.json or per-profile JSON files.
  while IFS= read -r -d '' f; do
    if [ "$include_backups" -eq 1 ] && [ -n "$f" ]; then files+=("$f"); fi
  done < <(find "$CLAUDE_HOME" -maxdepth 2 \( -name 'common.json.bak.*' -o -name '*.json.bak.*' \) -type f -print0 2>/dev/null)

  if [ "${#files[@]}" -eq 0 ] && [ "${#dirs[@]}" -eq 0 ]; then
    printf 'Nothing to clean.\n'
    return 0
  fi

  printf 'Selected cleanup items (stop affected CLIs before deletion):\n'
  for f in "${files[@]}"; do
    printf '  %6s  %s\n' "$(du -h "$f" 2>/dev/null | awk '{print $1}')" "$f"
  done
  for dir in "${dirs[@]}"; do
    size=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
    printf '  %6s  %s/\n' "${size:-?}" "$dir"
  done
  total=$(du -sch "${files[@]}" "${dirs[@]}" 2>/dev/null | tail -1 | awk '{print $1}')
  printf '\nTotal to free: %s\n' "$total"

  if [ "$dry_run" -eq 1 ]; then
    printf '(dry run; nothing deleted)\n'
    return 0
  fi

  if [ "$assume_yes" -ne 1 ]; then
    printf '\nMake sure Codex/Claude are not running, then confirm. Delete? [y/N]: '
    local answer
    IFS= read -r answer
    case "$answer" in
      [Yy]*) ;;
      *) printf 'Aborted.\n'; return 0 ;;
    esac
  fi

  local removed=0
  for f in "${files[@]}"; do
    rm -f "$f" && removed=$((removed + 1))
  done
  for dir in "${dirs[@]}"; do
    rm -rf "$dir" && removed=$((removed + 1))
  done
  printf 'Removed %s item(s).\n' "$removed"
}

main() {
  case "${1:-}" in
    ""|-h|--help|help)
      usage
      ;;
    status)
      shift
      qq_status "$@"
      ;;
    usage)
      shift
      [ "$#" -eq 0 ] || die "usage: boom usage"
      boom_usage
      ;;
    clean)
      shift
      boom_clean "$@"
      ;;
    plugins)
      shift
      local_plugins "${1:-list}" "${@:2}"
      ;;
    claude|c)
      shift
      handle_tool claude "$@"
      ;;
    codex|x)
      shift
      handle_tool codex "$@"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
