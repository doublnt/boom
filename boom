boom_usage() {
  node - "$CODEX_PROFILES" <<'NODE'
const fs = require("fs");
const path = require("path");
const os = require("os");
const [codexProfilesDir] = process.argv.slice(2);
const colorEnabled = Boolean(process.env.BOOM_FORCE_COLOR || process.env.CLICOLOR_FORCE) || (!process.env.NO_COLOR && process.stdout.isTTY);
const C = colorEnabled ? {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  green: "\x1b[32m",
  cyan: "\x1b[36m",
  magenta: "\x1b[35m",
  blue: "\x1b[34m",
} : {};
function paint(value, color) {
  return colorEnabled ? `${C[color]}${value}${C.reset}` : String(value);
}

const now = Date.now();
const dayStart = new Date();
dayStart.setHours(0, 0, 0, 0);
const todayMs = dayStart.getTime();
const sevenDaysMs = now - 7 * 24 * 60 * 60 * 1000;

function readDir(dir) {
  try { return fs.readdirSync(dir, { withFileTypes: true }); } catch { return []; }
}
function readLines(file) {
  try { return fs.readFileSync(file, "utf8").split(/\r?\n/); } catch { return []; }
}
function parseJson(line) {
  try { return JSON.parse(line); } catch { return null; }
}
function parseTime(value) {
  if (!value) return 0;
  const ts = Date.parse(value);
  return Number.isFinite(ts) ? ts : 0;
}
function num(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : 0;
}
function fmt(value) {
  return Math.round(value).toLocaleString("en-US");
}
function fmtShort(value) {
  // Compact k/M/B with one decimal; strip trailing ".0" for round numbers.
  // Below 1k we still emit an exact integer so small counts (e.g. files
  // scanned) read naturally without a forced unit.
  if (!Number.isFinite(value)) return "0";
  const abs = Math.abs(value);
  if (abs >= 1e9) {
    const v = (value / 1e9).toFixed(1);
    return `${v.endsWith(".0") ? v.slice(0, -2) : v}B`;
  }
  if (abs >= 1e6) {
    const v = (value / 1e6).toFixed(1);
    return `${v.endsWith(".0") ? v.slice(0, -2) : v}M`;
  }
  if (abs >= 1e3) {
    const v = (value / 1e3).toFixed(1);
    return `${v.endsWith(".0") ? v.slice(0, -2) : v}k`;
  }
  return String(Math.round(value));
}
function padRight(value, width) {
  const text = String(value);
  return text.length > width ? `${text.slice(0, Math.max(0, width - 1))}…` : text.padEnd(width, " ");
}
function totalOf(row) {
  return row.input + row.output + row.cacheRead + row.cacheCreate;
}
function empty() {
  return { input: 0, output: 0, cacheRead: 0, cacheCreate: 0, calls: 0 };
}
function add(dst, src) {
  dst.input += src.input;
  dst.output += src.output;
  dst.cacheRead += src.cacheRead;
  dst.cacheCreate += src.cacheCreate;
  dst.calls += src.calls;
}
function bucketFor(ts) {
  const buckets = ["all"];
  if (ts >= sevenDaysMs) buckets.push("7d");
  if (ts >= todayMs) buckets.push("today");
  return buckets;
}
function collectJsonl(dir, maxDepth = 10) {
  const files = [];
  function walk(current, depth) {
    if (depth > maxDepth) return;
    for (const entry of readDir(current)) {
      const full = path.join(current, entry.name);
      if (entry.isDirectory()) walk(full, depth + 1);
      else if (entry.isFile() && entry.name.endsWith(".jsonl")) files.push(full);
    }
  }
  walk(dir, 0);
  return files;
}
function collectGeminiSessions() {
  const base = path.join(os.homedir(), ".gemini", "tmp");
  const files = [];
  for (const project of readDir(base)) {
    if (!project.isDirectory()) continue;
    const chats = path.join(base, project.name, "chats");
    for (const entry of readDir(chats)) {
      if (!entry.isFile()) continue;
      if (/^session-.*\.jsonl?$/.test(entry.name)) files.push(path.join(chats, entry.name));
    }
  }
  return files;
}
function aggregate(rows) {
  const result = {
    today: empty(),
    "7d": empty(),
    all: empty(),
    models: new Map(),
  };
  for (const row of rows) {
    for (const bucket of bucketFor(row.ts)) add(result[bucket], row);
    const model = row.model || "unknown";
    if (!result.models.has(model)) result.models.set(model, empty());
    add(result.models.get(model), row);
  }
  return result;
}
function printSummary(title, rows, filesScanned) {
  console.log(paint(`== ${title} ==`, "bold"));
  if (!rows.length) {
    console.log(`  ${paint("No token records found.", "dim")} Files scanned: ${fmtShort(filesScanned)}`);
    return;
  }
  const agg = aggregate(rows);
  for (const [label, bucket] of [["Today", agg.today], ["7 days", agg["7d"]], ["All", agg.all]]) {
    console.log(`  ${paint(label, "cyan")}`);
    console.log(`    total ${paint(fmtShort(totalOf(bucket)), "green")} tokens, ${paint(fmtShort(bucket.calls), "magenta")} calls`);
    console.log(`    in ${paint(fmtShort(bucket.input), "blue")} | out ${paint(fmtShort(bucket.output), "blue")}`);
    console.log(`    cache read ${paint(fmtShort(bucket.cacheRead), "dim")} | write ${paint(fmtShort(bucket.cacheCreate), "dim")}`);
  }
  const topModels = [...agg.models.entries()]
    .sort((a, b) => totalOf(b[1]) - totalOf(a[1]))
    .slice(0, 5);
  if (topModels.length) {
    console.log("");
    console.log(`  ${paint("Top models", "cyan")}`);
    for (const [model, row] of topModels) {
      console.log(`    ${paint(padRight(model, 22), "magenta")} ${paint(fmtShort(totalOf(row)), "green")} tokens, ${fmtShort(row.calls)} calls`);
    }
  }
  console.log(`\n  ${paint("Files scanned:", "dim")} ${fmtShort(filesScanned)}`);
}

function claudeRows() {
  const dir = path.join(os.homedir(), ".claude", "projects");
  const files = collectJsonl(dir);
  const byMessage = new Map();
  for (const file of files) {
    for (const line of readLines(file)) {
      if (!line.trim() || !line.includes('"usage"')) continue;
      const value = parseJson(line);
      if (!value || value.type !== "assistant") continue;
      const message = value.message || {};
      const usage = message.usage || {};
      const id = message.id;
      if (!id) continue;
      const row = {
        ts: parseTime(value.timestamp),
        model: message.model || "unknown",
        input: num(usage.input_tokens),
        output: num(usage.output_tokens),
        cacheRead: num(usage.cache_read_input_tokens),
        cacheCreate: num(usage.cache_creation_input_tokens),
        calls: message.stop_reason ? 1 : 0,
        complete: Boolean(message.stop_reason),
      };
      if (row.output === 0 && row.input === 0 && row.cacheRead === 0 && row.cacheCreate === 0) continue;
      const prev = byMessage.get(id);
      const shouldReplace = !prev ||
        (row.complete && !prev.complete) ||
        (row.complete === prev.complete && row.output > prev.output);
      if (shouldReplace) byMessage.set(id, row);
    }
  }
  const rows = [...byMessage.values()].filter((row) => row.complete && row.output > 0);
  return { rows, filesScanned: files.length };
}

function cumulativeFrom(info) {
  if (!info || typeof info !== "object") return null;
  return {
    input: num(info.input_tokens),
    cacheRead: num(info.cached_input_tokens ?? info.cache_read_input_tokens),
    output: num(info.output_tokens),
  };
}
function delta(prev, current) {
  if (!prev) return current;
  return {
    input: Math.max(0, current.input - prev.input),
    cacheRead: Math.max(0, current.cacheRead - prev.cacheRead),
    output: Math.max(0, current.output - prev.output),
  };
}
function codexRoots() {
  const roots = [];
  const homeCodex = path.join(os.homedir(), ".codex");
  if (fs.existsSync(homeCodex)) roots.push({ label: "home", dir: homeCodex });
  for (const entry of readDir(codexProfilesDir)) {
    if (entry.isDirectory()) roots.push({ label: entry.name, dir: path.join(codexProfilesDir, entry.name) });
  }
  return roots;
}
function codexRowsForRoot(root, seen) {
  const files = [
    ...collectJsonl(path.join(root.dir, "sessions"), 5),
    ...collectJsonl(path.join(root.dir, "archived_sessions"), 2),
  ];
  const rows = [];
  let filesScanned = 0;
  for (const file of files) {
    // Boom-managed profiles symlink sessions/ and archived_sessions/ to
    // ~/.boom/codex/shared/{sessions,archived_sessions}, so the same file
    // appears under every profile root. Dedupe by realpath so we only
    // count each session file once across all roots.
    let real;
    try { real = fs.realpathSync(file); } catch { real = file; }
    if (seen.has(real)) continue;
    seen.add(real);
    filesScanned += 1;
    let currentModel = "unknown";
    let prevTotal = null;
    for (const line of readLines(file)) {
      if (!line.trim()) continue;
      const value = parseJson(line);
      if (!value) continue;
      if (value.type === "turn_context" && value.payload?.model) currentModel = value.payload.model;
      if (value.type !== "event_msg" || value.payload?.type !== "token_count") continue;
      const info = value.payload.info || {};
      let d = null;
      if (info.total_token_usage) {
        const total = cumulativeFrom(info.total_token_usage);
        if (!total) continue;
        d = delta(prevTotal, total);
        prevTotal = total;
      } else if (info.last_token_usage) {
        d = cumulativeFrom(info.last_token_usage);
      }
      if (!d || (d.input === 0 && d.cacheRead === 0 && d.output === 0)) continue;
      rows.push({
        ts: parseTime(value.timestamp),
        model: info.model || currentModel,
        input: d.input,
        output: d.output,
        cacheRead: Math.min(d.cacheRead, d.input),
        cacheCreate: 0,
        calls: 1,
      });
    }
  }
  return { rows, filesScanned };
}

function geminiRowFromMessage(msg) {
  if (!msg || msg.type !== "gemini" || !msg.tokens || typeof msg.tokens !== "object") return null;
  const input = num(msg.tokens.input);
  const output = num(msg.tokens.output) + num(msg.tokens.thoughts);
  const cacheRead = num(msg.tokens.cached);
  if (input === 0 && output === 0 && cacheRead === 0) return null;
  return {
    ts: parseTime(msg.timestamp),
    model: msg.model || "unknown",
    input,
    output,
    cacheRead,
    cacheCreate: 0,
    calls: 1,
  };
}
function geminiRows() {
  const files = collectGeminiSessions();
  const byMessage = new Map();
  for (const file of files) {
    if (file.endsWith(".jsonl")) {
      for (const line of readLines(file)) {
        if (!line.trim() || !line.includes('"tokens"')) continue;
        const msg = parseJson(line);
        const row = geminiRowFromMessage(msg);
        if (!row) continue;
        const id = msg.id || `${file}:${row.ts}:${byMessage.size}`;
        byMessage.set(`${file}:${id}`, row);
      }
      continue;
    }

    let value = null;
    try { value = JSON.parse(fs.readFileSync(file, "utf8")); } catch { continue; }
    const messages = Array.isArray(value?.messages) ? value.messages : [];
    for (const msg of messages) {
      const row = geminiRowFromMessage(msg);
      if (!row) continue;
      const id = msg.id || `${file}:${row.ts}:${byMessage.size}`;
      byMessage.set(`${file}:${id}`, row);
    }
  }
  return { rows: [...byMessage.values()], filesScanned: files.length };
}

const claude = claudeRows();
printSummary("Claude Usage", claude.rows, claude.filesScanned);
console.log("");
// Aggregate every codex root (home + each boom profile) into a single
// summary. Profiles share sessions/archived_sessions via symlinks to
// ~/.boom/codex/shared, so dedupe by realpath inside codexRowsForRoot
// to avoid counting the same files once per profile.
const codexSeen = new Set();
const codexRows = [];
let codexFilesScanned = 0;
for (const root of codexRoots()) {
  const codex = codexRowsForRoot(root, codexSeen);
  for (const row of codex.rows) codexRows.push(row);
  codexFilesScanned += codex.filesScanned;
}
printSummary("Codex Usage", codexRows, codexFilesScanned);
console.log("");
const gemini = geminiRows();
printSummary("Gemini Usage", gemini.rows, gemini.filesScanned);
NODE
}

