    console.log(`  ${paint(label, "cyan")}`);
    console.log(`    total ${paint(fmt(totalOf(bucket)), "green")} tokens, ${paint(fmt(bucket.calls), "magenta")} calls`);
    console.log(`    in ${paint(fmt(bucket.input), "blue")} | out ${paint(fmt(bucket.output), "blue")}`);
    console.log(`    cache read ${paint(fmt(bucket.cacheRead), "dim")} | write ${paint(fmt(bucket.cacheCreate), "dim")}`);
  }
