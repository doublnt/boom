qq_status() {
  local target=all official=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --claude|--codex)
        [ "$target" = all ] || die "choose only one of --claude and --codex"
        target="${1#--}" ;;
      --official) official=1 ;;
      --help|-h) printf 'Usage: boom status [--claude|--codex] [--official]\n'; return 0 ;;
      *) die "unknown status option: $1" ;;
    esac
    shift
  done
  node - "$CLAUDE_DEFAULT" "$CLAUDE_PROFILES" "$CODEX_DEFAULT" "$CODEX_PROFILES" "$target" "$official" <<'NODE'
const fs = require("fs");
const { execFileSync } = require("child_process");
const [claudeDefaultPath, claudeProfilesDir, codexDefaultPath, codexProfilesDir, target, officialOnly] = process.argv.slice(2);
const validPercent = n => typeof n === "number" && Number.isFinite(n) && n >= 0 && n <= 100;
const remaining = n => validPercent(n) ? 100 - n : undefined;
const colorEnabled = Boolean(process.env.BOOM_FORCE_COLOR || process.env.CLICOLOR_FORCE) || (!process.env.NO_COLOR && process.stdout.isTTY);
const C = colorEnabled ? {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  green: "\x1b[32m",
  yellow: "\x1b[33m",
  red: "\x1b[31m",
  cyan: "\x1b[36m",
  magenta: "\x1b[35m",
} : {};
function paint(value, color) {
  return colorEnabled ? `${C[color]}${value}${C.reset}` : String(value);
}
function statusColor(status) {
  if (status === "ok") return "green";
  if (status === "high") return "yellow";
  if (status === "limited") return "red";
  return "dim";
}
function usageColor(value) {
  // `value` is remaining quota (0..100); flip the color thresholds so low
  // remaining reads red, healthy remaining reads green.
  if (typeof value !== "number" || !Number.isFinite(value)) return "dim";
  if (value <= 5) return "red";
  if (value <= 20) return "yellow";
  return "green";
}

function readText(file) {
  try { return fs.readFileSync(file, "utf8").trim(); } catch { return ""; }
}
function readJson(file) {
  return JSON.parse(fs.readFileSync(file, "utf8"));
}
function pct(value) {
  if (typeof value !== "number" || !Number.isFinite(value)) return "unknown";
  return `${Math.round(value)}%`;
}
function localTime(value) {
  if (value === null || value === undefined || value === "") return "unknown";
  let date;
  if (typeof value === "number") date = new Date(value < 1e12 ? value * 1000 : value);
  else date = new Date(value);
  if (Number.isNaN(date.getTime())) return "unknown";
  return date.toLocaleString(undefined, {
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
}
function line(label, left, reset) {
  // Subscription windows display remaining quota; callers pass 100 - utilization.
  console.log(`  ${paint(label, "cyan")}: ${paint(pct(left), usageColor(left))} left, reset ${paint(localTime(reset), "dim")}`);
}
function section(title) {
  console.log(paint(title, "bold"));
}
function fail(msg) {
  console.log(`  ${paint(`unknown: ${msg}`, "red")}`);
  process.exitCode = 1;
}
function claudeTokenFromKeychain() {
  try {
    const raw = execFileSync("security", ["find-generic-password", "-s", "Claude Code-credentials", "-w"], {
      encoding: "utf8",
      timeout: 5000,
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
    const json = JSON.parse(raw);
    return (json.claudeAiOauth || json["claude.ai_oauth"] || {}).accessToken || "";
  } catch {
    return "";
  }
}
function claudeTokenFromFile() {
  try {
    const json = readJson(`${process.env.CLAUDE_CONFIG_DIR || `${process.env.HOME}/.claude`}/.credentials.json`);
    return (json.claudeAiOauth || json["claude.ai_oauth"] || {}).accessToken || "";
  } catch {
    return "";
  }
}
function statusForUtilization(values) {
  const max = values.filter(validPercent).reduce((a, b) => Math.max(a, b), -1);
  if (max < 0) return "unknown";
  if (max >= 95) return "limited";
  if (max >= 80) return "high";
  return "ok";
}
async function fetchJson(url, options) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 10000);
  try {
    const res = await fetch(url, { ...options, redirect: "error", signal: controller.signal });
    const text = await res.text();
    let body = null;
    try { body = text ? JSON.parse(text) : null; } catch {}
    return { ok: res.ok, status: res.status, body, text };
  } finally {
    clearTimeout(timer);
  }
}

async function showClaudeOfficial() {
  section("Claude Official");
  // A custom config directory must not silently select the default keychain account.
  const token = (process.env.CLAUDE_CONFIG_DIR ? "" : claudeTokenFromKeychain()) || claudeTokenFromFile();
  if (!token) {
    fail("not logged in or credential not found");
    return;
  }
  try {
    const res = await fetchJson("https://api.anthropic.com/api/oauth/usage", {
      headers: {
        Authorization: `Bearer ${token}`,
        "anthropic-beta": "oauth-2025-04-20",
        Accept: "application/json",
      },
    });
    if (!res.ok || !res.body) {
      fail(`query failed: HTTP ${res.status}`);
      return;
    }
    const body = res.body;
    const values = [];
    if (validPercent(body.five_hour?.utilization)) {
      const used = body.five_hour.utilization;
      values.push(used);
      line("5h", remaining(used), body.five_hour.resets_at);
    }
    for (const key of Object.keys(body).filter(key => /^seven_day(?:_[a-z0-9_]+)?$/.test(key)).sort()) {
      const item = body[key];
      if (item && validPercent(item.utilization)) {
        values.push(item.utilization);
        line(key.replace("seven_day", "7d").replace(/_/g, " "), remaining(item.utilization), item.resets_at);
      }
    }
    if (!values.length) fail("no quota windows returned");
    const extra = body.extra_usage;
    if (extra && extra.is_enabled) {
      const limit = extra.monthly_limit ?? "unknown";
      const used = extra.used_credits ?? "unknown";
      console.log(`  extra: ${used}/${limit} ${extra.currency || ""}`.trimEnd());
    }
    const status = statusForUtilization(values);
    console.log(`  status: ${paint(status, statusColor(status))}`);
  } catch (e) {
    fail(`query failed: ${e.message}`);
  }
}

function listClaudeProfileNames() {
  try {
    return fs.readdirSync(claudeProfilesDir)
      .filter((name) => name.endsWith(".json"))
      .map((name) => name.slice(0, -5))
      .sort((a, b) => a.localeCompare(b));
  } catch {
    return [];
  }
}
function listCodexProfileNames() {
  try {
    return fs.readdirSync(codexProfilesDir, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => entry.name)
      .sort((a, b) => a.localeCompare(b));
  } catch {
    return [];
  }
}

async function showClaudeCodingPlanProfile(name) {
  const file = `${claudeProfilesDir}/${name}.json`;
  if (!fs.existsSync(file)) return false;
  let profile;
  try { profile = readJson(file); } catch { return false; }
  const env = profile.env || {};
  const base = env.ANTHROPIC_BASE_URL || "";
  const token = env.ANTHROPIC_AUTH_TOKEN || env.ANTHROPIC_API_KEY || "";
  if (!base || !token) return false;
  if (!/api\.minimax(i)?\.(com|io)/i.test(base)) return false;

  const defaultName = readText(claudeDefaultPath);
  section(`Claude MiniMax (${name}${name === defaultName ? ", default" : ""})`);
  try {
    const host = base.includes("api.minimax.io") ? "api.minimax.io" : "api.minimaxi.com";
    const res = await fetchJson(`https://${host}/v1/api/openplatform/coding_plan/remains`, {
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
    });
    if (!res.ok || !res.body) {
      fail(`query failed: HTTP ${res.status}`);
      return true;
    }
    const first = (res.body.model_remains || [])[0];
    if (!first) {
      fail("no coding plan data returned");
      return true;
    }
    // MiniMax now exposes remaining quota as a percentage; the legacy
    // current_interval_total_count / usage_count fields are always 0.
    const asPercent = x => (typeof x === "number" || (typeof x === "string" && x.trim())) && validPercent(Number(x)) ? Number(x) : NaN;
    const fiveLeft = asPercent(first.current_interval_remaining_percent);
    const weekLeft = asPercent(first.current_weekly_remaining_percent);
    const clampUsed = (n) => Number.isFinite(n) ? Math.min(100, Math.max(0, 100 - n)) : NaN;
    const clampLeft = (n) => Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : NaN;
    const values = [];
    if (Number.isFinite(fiveLeft)) {
      const used = clampUsed(fiveLeft);
      const left = clampLeft(fiveLeft);
      values.push(used);
      line("5h", left, first.end_time);
    }
    if (Number.isFinite(weekLeft)) {
      const used = clampUsed(weekLeft);
      const left = clampLeft(weekLeft);
      values.push(used);
      line("weekly", left, first.weekly_end_time);
    }
    if (!values.length) fail("no quota windows returned");
    const status = statusForUtilization(values);
    console.log(`  status: ${paint(status, statusColor(status))}`);
  } catch (e) {
    fail(`query failed: ${e.message}`);
  }
  return true;
}

async function showAllClaudeCodingPlans() {
  let shown = 0;
  for (const name of listClaudeProfileNames()) {
    const didShow = await showClaudeCodingPlanProfile(name);
    if (didShow) shown += 1;
    if (didShow) console.log("");
  }
  return shown;
}

async function showCodex(name, authPath = `${codexProfilesDir}/${name}/auth.json`) {
  const defaultName = readText(codexDefaultPath);
  section(`Codex (${name}${name === defaultName ? ", default" : ""})`);
  let auth;
  try { auth = readJson(authPath); } catch {
    fail("auth.json not found or invalid");
    return;
  }
  if (auth.auth_mode !== "chatgpt" || !auth.tokens?.access_token) {
    fail("not using ChatGPT login");
    return;
  }
  try {
    const headers = {
      Authorization: `Bearer ${auth.tokens.access_token}`,
      "User-Agent": "codex-cli",
      Accept: "application/json",
