#!/bin/bash

set -eo pipefail

BOOM_HOME="${BOOM_HOME:-$HOME/.boom}"
REAL_CLAUDE="${BOOM_REAL_CLAUDE:-}"
REAL_CODEX="${BOOM_REAL_CODEX:-/opt/homebrew/bin/codex}"

CLAUDE_HOME="$BOOM_HOME/claude"
CLAUDE_PROFILES="$CLAUDE_HOME/profiles"
CLAUDE_COMMON="$CLAUDE_HOME/common.json"
CLAUDE_DEFAULT="$CLAUDE_HOME/default"

CODEX_HOME_ROOT="$BOOM_HOME/codex"
CODEX_PROFILES="$CODEX_HOME_ROOT/profiles"
CODEX_DEFAULT="$CODEX_HOME_ROOT/default"
CODEX_SHARED="$CODEX_HOME_ROOT/shared"

die() {
  printf 'boom: %s\n' "$*" >&2
  exit 1
}

find_real_claude() {
  local candidate
  if [ -n "${REAL_CLAUDE:-}" ]; then
    printf '%s\n' "$REAL_CLAUDE"
    return 0
  fi
  for candidate in "$HOME/.local/bin/claude" "/opt/homebrew/bin/claude" "/usr/local/bin/claude"; do
    if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  while IFS= read -r candidate; do
    if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(command -v -a claude 2>/dev/null || which -a claude 2>/dev/null || true)
  return 1
}

REAL_CLAUDE="$(find_real_claude || true)"

usage() {
  cat <<'EOF'
boom - unified Claude/Codex launcher

Usage:
  boom
  boom -h | --help | help
  boom status
  boom usage

  boom claude [name] [--safe] [--no-profile] [-- <claude args...>]
  boom codex  [name] [--safe] [--no-profile] [-- <codex args...>]

Short aliases:
  boom c [name] [...]
  boom x [name] [...]

Claude commands:
  boom claude list
  boom claude add <name>
  boom claude edit [name]
  boom claude show [name]
  boom claude default <name>
  boom claude remove <name>
  boom claude doctor

Codex commands:
  boom codex add <name>
  boom codex edit [name]
  boom codex list
  boom codex list
  boom codex default <name>
  boom codex remove <name>
  boom codex doctor

Examples:
  boom claude
  boom claude myplan
  boom claude list
  boom status
  boom usage
  boom codex
  boom codex add work
  boom codex work
  boom codex list
  boom claude myplan -- -p "reply OK"
  boom codex work -- exec "reply OK"

By default boom adds the existing fast-path permissions:
  Claude: --dangerously-skip-permissions
  Codex:  --dangerously-bypass-approvals-and-sandbox

Use --safe to skip those flags.
EOF
}

ensure_dir() {
  mkdir -p "$1"
  chmod 700 "$1" 2>/dev/null || true
}

ensure_layout() {
  ensure_dir "$BOOM_HOME"
  ensure_dir "$CLAUDE_HOME"
  ensure_dir "$CLAUDE_PROFILES"
  ensure_dir "$CODEX_HOME_ROOT"
  ensure_dir "$CODEX_PROFILES"
}

validate_name() {
  local name="$1"
  [ -n "$name" ] || die "name cannot be empty"
  case "$name" in
    *[!A-Za-z0-9._-]*)
      die "name can only contain letters, numbers, dot, underscore, and dash"
      ;;
  esac
}

normalize_name() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

get_default() {
  local file="$1"
  if [ -f "$file" ]; then
    head -n 1 "$file" | tr -d '[:space:]'
  fi
}

set_default_file() {
  local file="$1"
  local name="$2"
  umask 077
  printf '%s\n' "$name" > "$file"
  chmod 600 "$file"
}

profile_name_from_json_path() {
  local file="$1"
  local base="${file##*/}"
  printf '%s\n' "${base%.json}"
}

resolve_claude_profile() {
  local requested="$1"
  local requested_norm
  local file
  local base
  local match=""

  validate_name "$requested"
  requested_norm="$(normalize_name "$requested")"

  if [ -f "$CLAUDE_PROFILES/$requested.json" ]; then
    printf '%s\n' "$CLAUDE_PROFILES/$requested.json"
    return 0
  fi

  for file in "$CLAUDE_PROFILES"/*.json; do
    [ -e "$file" ] || continue
    base="$(profile_name_from_json_path "$file")"
    if [ "$(normalize_name "$base")" = "$requested_norm" ]; then
      [ -z "$match" ] || die "multiple Claude configs match '$requested'; use the exact name"
      match="$file"
    fi
  done

  [ -n "$match" ] || return 1
  printf '%s\n' "$match"
}

resolve_codex_profile() {
  local requested="$1"
  local requested_norm
  local dir
  local base
  local match=""

  validate_name "$requested"
  requested_norm="$(normalize_name "$requested")"

  if [ -d "$CODEX_PROFILES/$requested" ]; then
    printf '%s\n' "$CODEX_PROFILES/$requested"
    return 0
  fi

  for dir in "$CODEX_PROFILES"/*; do
    [ -d "$dir" ] || continue
    base="${dir##*/}"
    if [ "$(normalize_name "$base")" = "$requested_norm" ]; then
      [ -z "$match" ] || die "multiple Codex configs match '$requested'; use the exact name"
      match="$dir"
    fi
  done

  [ -n "$match" ] || return 1
  printf '%s\n' "$match"
}

list_claude_names() {
  local file
  for file in "$CLAUDE_PROFILES"/*.json; do
    [ -e "$file" ] || continue
    profile_name_from_json_path "$file"
  done | sort
}

list_codex_names() {
  local dir
  for dir in "$CODEX_PROFILES"/*; do
    [ -d "$dir" ] || continue
    printf '%s\n' "${dir##*/}"
  done | sort
}

print_missing_profiles() {
  local kind="$1"
  if [ "$kind" = "claude" ]; then
    list_claude_names | sed 's/^/  /' >&2
  else
    list_codex_names | sed 's/^/  /' >&2
  fi
}

merged_claude_settings() {
  local profile_path="$1"
  local tmp_path

  tmp_path="$(mktemp "${TMPDIR:-/tmp}/boom-claude-settings.XXXXXX")"
  chmod 600 "$tmp_path"

  node - "$CLAUDE_COMMON" "$profile_path" "$tmp_path" <<'NODE'
const fs = require("fs");
const [commonPath, profilePath, outputPath] = process.argv.slice(2);

function readJson(file) {
  if (!fs.existsSync(file)) return {};
  return JSON.parse(fs.readFileSync(file, "utf8"));
}
function isObj(value) {
  return value && typeof value === "object" && !Array.isArray(value);
}
function merge(base, override) {
  const result = { ...base };
  for (const [key, value] of Object.entries(override)) {
    result[key] = isObj(result[key]) && isObj(value) ? merge(result[key], value) : value;
  }
  return result;
}

const common = readJson(commonPath);
const profile = readJson(profilePath);
const merged = merge(common, profile);
const env = profile.env && typeof profile.env === "object" && !Array.isArray(profile.env)
  ? profile.env
  : {};

if (!("model" in profile) && !env.ANTHROPIC_MODEL && !env.ANTHROPIC_BASE_URL && !env.ANTHROPIC_AUTH_TOKEN) {
  delete merged.model;
}

fs.writeFileSync(outputPath, `${JSON.stringify(merged, null, 2)}\n`, { mode: 0o600 });
NODE

  printf '%s\n' "$tmp_path"
}

is_official_claude_profile() {
  local profile_path="$1"
  node - "$profile_path" <<'NODE'
const fs = require("fs");
const profile = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const env = profile.env && typeof profile.env === "object" && !Array.isArray(profile.env)
  ? profile.env
  : {};
const hasThirdPartyConfig = Boolean(
  env.ANTHROPIC_BASE_URL ||
  env.ANTHROPIC_API_KEY ||
  env.ANTHROPIC_AUTH_TOKEN ||
  env.ANTHROPIC_MODEL ||
  env.ANTHROPIC_REASONING_MODEL ||
  env.ANTHROPIC_DEFAULT_HAIKU_MODEL ||
  env.ANTHROPIC_DEFAULT_OPUS_MODEL ||
  env.ANTHROPIC_DEFAULT_SONNET_MODEL ||
  env.ANTHROPIC_SMALL_FAST_MODEL ||
  profile.apiBaseUrl ||
  profile.primaryModel ||
  profile.smallFastModel ||
  profile.model
);
process.exit(hasThirdPartyConfig ? 1 : 0);
NODE
}

clear_claude_provider_env() {
  unset ANTHROPIC_BASE_URL
  unset ANTHROPIC_AUTH_TOKEN
  unset ANTHROPIC_API_KEY
  unset ANTHROPIC_MODEL
  unset ANTHROPIC_REASONING_MODEL
  unset ANTHROPIC_DEFAULT_HAIKU_MODEL
  unset ANTHROPIC_DEFAULT_OPUS_MODEL
  unset ANTHROPIC_DEFAULT_SONNET_MODEL
  unset ANTHROPIC_SMALL_FAST_MODEL
  unset CLAUDE_CODE_SUBAGENT_MODEL
  unset CLAUDE_CODE_EFFORT_LEVEL
  unset CLAUDE_CODE_USE_BEDROCK
  unset CLAUDE_CODE_USE_VERTEX
}

run_claude_with_settings() {
  local profile_path="$1"
  shift
  local settings_path
  local status

  settings_path="$(merged_claude_settings "$profile_path")"
  clear_claude_provider_env
  "$REAL_CLAUDE" --settings "$settings_path" "$@"
  status=$?
  rm -f "$settings_path"
  exit "$status"
}

run_claude_with_user_settings_swap() {
  local profile_path="$1"
  shift
  local settings_file="$HOME/.claude/settings.json"
  local backup_file
  local effective_settings
  local merged_settings
  local status

  mkdir -p "$HOME/.claude"
  backup_file="$(mktemp "${TMPDIR:-/tmp}/boom-claude-user-settings.XXXXXX")"
  effective_settings="$(mktemp "${TMPDIR:-/tmp}/boom-claude-official-settings.XXXXXX")"
  if [ -f "$settings_file" ]; then
    cp "$settings_file" "$backup_file"
  else
    : > "$backup_file"
  fi

  restore_settings() {
    if [ -s "$backup_file" ]; then
      cp "$backup_file" "$settings_file"
      chmod 600 "$settings_file" 2>/dev/null || true
    else
      rm -f "$settings_file"
    fi
    rm -f "$backup_file" "$effective_settings" "${merged_settings:-}"
  }

  trap restore_settings EXIT INT TERM

  merged_settings="$(merged_claude_settings "$profile_path")"
  node - "$merged_settings" "$effective_settings" <<'NODE'
const fs = require("fs");
const [settingsPath, outputPath] = process.argv.slice(2);
const profile = JSON.parse(fs.readFileSync(settingsPath, "utf8"));
for (const key of ["api_format", "apiFormat", "openrouter_compat_mode", "openrouterCompatMode"]) {
  delete profile[key];
}
fs.writeFileSync(outputPath, `${JSON.stringify(profile, null, 2)}\n`, { mode: 0o600 });
NODE

  cp "$effective_settings" "$settings_file"
  chmod 600 "$settings_file" 2>/dev/null || true
  clear_claude_provider_env
  "$REAL_CLAUDE" "$@"
  status=$?
  restore_settings
  trap - EXIT INT TERM
  exit "$status"
}

claude_add() {
  local name="${1:-}"
  local path
  local base_url
  local api_key
  local model

  validate_name "$name"
  path="$CLAUDE_PROFILES/$name.json"
  [ ! -e "$path" ] || die "Claude config '$name' already exists"

  printf 'Base URL: '
  IFS= read -r base_url
  printf 'API Key: '
  if [ -t 0 ]; then
    stty -echo
    IFS= read -r api_key
    stty echo
    printf '\n'
  else
    IFS= read -r api_key
  fi
  printf 'Model: '
  IFS= read -r model

  [ -n "$base_url" ] || die "base URL is required"
  [ -n "$api_key" ] || die "API key is required"
  [ -n "$model" ] || die "model is required"

  umask 077
  cat > "$path" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "$(json_escape "$base_url")",
    "ANTHROPIC_AUTH_TOKEN": "$(json_escape "$api_key")",
    "ANTHROPIC_MODEL": "$(json_escape "$model")",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "$(json_escape "$model")",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "$(json_escape "$model")",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "$(json_escape "$model")",
    "CLAUDE_CODE_SUBAGENT_MODEL": "$(json_escape "$model")",
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
EOF
  chmod 600 "$path"
  printf "Added Claude config '%s'.\n" "$name"
}

claude_edit() {
  local requested="${1:-}"
  local path
  local current_name
  local current_base_url
  local current_model
  local is_official=0
  local new_name
  local new_base_url
  local new_api_key
  local new_model
  local new_path
  local tmp_path
  local default_profile

  if [ -z "$requested" ]; then
    requested="$(get_default "$CLAUDE_DEFAULT")"
    [ -n "$requested" ] || die "usage: boom claude edit <name>"
  fi

  if ! path="$(resolve_claude_profile "$requested")"; then
    printf "Claude config '%s' does not exist.\n" "$requested" >&2
    print_missing_profiles claude
    exit 1
  fi

  current_name="$(profile_name_from_json_path "$path")"
  current_base_url="$(node -e 'const fs=require("fs"); const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write((j.env&&j.env.ANTHROPIC_BASE_URL)||"");' "$path")"
  current_model="$(node -e 'const fs=require("fs"); const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); const e=j.env||{}; process.stdout.write(e.ANTHROPIC_MODEL||e.ANTHROPIC_DEFAULT_SONNET_MODEL||"");' "$path")"
  if is_official_claude_profile "$path"; then
    is_official=1
  fi

  printf 'Profile name [%s]: ' "$current_name"
  IFS= read -r new_name
  [ -n "$new_name" ] || new_name="$current_name"
  validate_name "$new_name"

  new_path="$CLAUDE_PROFILES/$new_name.json"
  [ "$new_path" = "$path" ] || [ ! -e "$new_path" ] || die "Claude config '$new_name' already exists"

  if [ "$is_official" -eq 1 ]; then
    if [ "$new_path" != "$path" ]; then
      mv "$path" "$new_path"
      chmod 600 "$new_path"
    fi
  else
    printf 'Base URL [%s]: ' "$current_base_url"
    IFS= read -r new_base_url
    [ -n "$new_base_url" ] || new_base_url="$current_base_url"

    printf 'API Key [leave blank to keep current]: '
    if [ -t 0 ]; then
      stty -echo
      IFS= read -r new_api_key
      stty echo
      printf '\n'
    else
      IFS= read -r new_api_key
    fi

    printf 'Model [%s]: ' "$current_model"
    IFS= read -r new_model
    [ -n "$new_model" ] || new_model="$current_model"
    [ -n "$new_base_url" ] || die "base URL is required"
    [ -n "$new_model" ] || die "model is required"

    tmp_path="$(mktemp "$CLAUDE_PROFILES/.${new_name}.tmp.XXXXXX")"
    chmod 600 "$tmp_path"
    node - "$path" "$tmp_path" "$new_base_url" "$new_api_key" "$new_model" <<'NODE'
const fs = require("fs");
const [inputPath, outputPath, baseUrl, apiKey, model] = process.argv.slice(2);
const config = JSON.parse(fs.readFileSync(inputPath, "utf8"));
config.env = config.env && typeof config.env === "object" && !Array.isArray(config.env) ? config.env : {};
config.env.ANTHROPIC_BASE_URL = baseUrl;
if (apiKey) config.env.ANTHROPIC_AUTH_TOKEN = apiKey;
config.env.ANTHROPIC_MODEL = model;
config.env.ANTHROPIC_DEFAULT_SONNET_MODEL = model;
config.env.ANTHROPIC_DEFAULT_OPUS_MODEL = model;
config.env.ANTHROPIC_DEFAULT_HAIKU_MODEL = model;
config.env.CLAUDE_CODE_SUBAGENT_MODEL = model;
fs.writeFileSync(outputPath, `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 });
NODE
    mv "$tmp_path" "$new_path"
    chmod 600 "$new_path"
  fi

  if [ "$new_path" != "$path" ]; then
    default_profile="$(get_default "$CLAUDE_DEFAULT")"
    if [ "$default_profile" = "$current_name" ]; then
      set_default_file "$CLAUDE_DEFAULT" "$new_name"
    fi
    printf "Updated Claude config '%s' and renamed it to '%s'.\n" "$current_name" "$new_name"
  else
    printf "Updated Claude config '%s'.\n" "$current_name"
  fi
}

claude_show() {
  local requested=""
  local path
  local settings_path

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'Usage: boom claude show [name]\n'
        return 0
        ;;
      *)
        [ -z "$requested" ] || die "usage: boom claude show [name]"
        requested="$1"
        ;;
    esac
    shift || true
  done

  if [ -z "$requested" ]; then
    requested="$(get_default "$CLAUDE_DEFAULT")"
    [ -n "$requested" ] || die "usage: boom claude show <name> (or set a default Claude config first)"
  fi

  if ! path="$(resolve_claude_profile "$requested")"; then
    printf "Claude config '%s' does not exist.\n" "$requested" >&2
    print_missing_profiles claude
    exit 1
  fi

  settings_path="$(merged_claude_settings "$path")"
  jq . "$settings_path"
  rm -f "$settings_path"
}

profile_list() {
  local kind="$1"
  local default_file="$2"
  local name
  local default_profile
  local count=0

  default_profile="$(get_default "$default_file")"
  if [ "$kind" = "claude" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      count=$((count + 1))
      [ "$name" = "$default_profile" ] && printf '* %s (default)\n' "$name" || printf '  %s\n' "$name"
    done < <(list_claude_names)
  else
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      count=$((count + 1))
      [ "$name" = "$default_profile" ] && printf '* %s (default)\n' "$name" || printf '  %s\n' "$name"
    done < <(list_codex_names)
  fi
  [ "$count" -gt 0 ] || printf 'No %s configs found.\n' "$kind"
}

claude_default() {
  local requested="${1:-}"
  local path
  [ -n "$requested" ] || die "usage: boom claude default <name>"
  path="$(resolve_claude_profile "$requested")" || die "Claude config '$requested' does not exist"
  set_default_file "$CLAUDE_DEFAULT" "$(profile_name_from_json_path "$path")"
  printf "Default Claude config set to '%s'.\n" "$(profile_name_from_json_path "$path")"
}

codex_default() {
  local requested="${1:-}"
  local dir
  [ -n "$requested" ] || die "usage: boom codex default <name>"
  dir="$(resolve_codex_profile "$requested")" || die "Codex config '$requested' does not exist"
  set_default_file "$CODEX_DEFAULT" "${dir##*/}"
  printf "Default Codex config set to '%s'.\n" "${dir##*/}"
}

claude_remove() {
  local requested="${1:-}"
  local path
  local name
  local default_profile
  [ -n "$requested" ] || die "usage: boom claude remove <name>"
  path="$(resolve_claude_profile "$requested")" || die "Claude config '$requested' does not exist"
  name="$(profile_name_from_json_path "$path")"
  rm -f "$path"
  default_profile="$(get_default "$CLAUDE_DEFAULT")"
  if [ "$default_profile" = "$name" ]; then
    rm -f "$CLAUDE_DEFAULT"
    printf "Removed Claude config '%s' and cleared the default.\n" "$name"
  else
    printf "Removed Claude config '%s'.\n" "$name"
  fi
}

codex_remove() {
  local requested="${1:-}"
  local dir
  local name
  local default_profile
  [ -n "$requested" ] || die "usage: boom codex remove <name>"
  dir="$(resolve_codex_profile "$requested")" || die "Codex config '$requested' does not exist"
  name="${dir##*/}"
  rm -rf "$dir"
  default_profile="$(get_default "$CODEX_DEFAULT")"
  if [ "$default_profile" = "$name" ]; then
    rm -f "$CODEX_DEFAULT"
    printf "Removed Codex config '%s' and cleared the default.\n" "$name"
  else
    printf "Removed Codex config '%s'.\n" "$name"
  fi
}

codex_edit() {
  local requested="${1:-}"
  local dir
  local current_name
  local new_name
  local new_dir
  local default_profile
  local do_login=0
  local status

  if [ -z "$requested" ]; then
    requested="$(get_default "$CODEX_DEFAULT")"
    [ -n "$requested" ] || die "usage: boom codex edit <name>"
  fi

  if ! dir="$(resolve_codex_profile "$requested")"; then
    printf "Codex config '%s' does not exist.\n" "$requested" >&2
    print_missing_profiles codex
    exit 1
  fi

  current_name="${dir##*/}"

  printf 'Profile name [%s]: ' "$current_name"
  IFS= read -r new_name
  [ -n "$new_name" ] || new_name="$current_name"
  validate_name "$new_name"

  new_dir="$CODEX_PROFILES/$new_name"
  [ "$new_dir" = "$dir" ] || [ ! -e "$new_dir" ] || die "Codex config '$new_name' already exists"

  printf 'Re-login? [y/N]: '
  IFS= read -r do_login_answer
  case "$do_login_answer" in
    [Yy]*) do_login=1 ;;
  esac

  if [ "$new_dir" != "$dir" ]; then
    mv "$dir" "$new_dir"
    default_profile="$(get_default "$CODEX_DEFAULT")"
    if [ "$default_profile" = "$current_name" ]; then
      set_default_file "$CODEX_DEFAULT" "$new_name"
    fi
    printf "Renamed Codex config '%s' to '%s'.\n" "$current_name" "$new_name"
    dir="$new_dir"
  else
    printf "Codex config '%s' unchanged.\n" "$current_name"
  fi

  if [ "$do_login" -eq 1 ]; then
    printf "Starting Codex login for '%s'. Finish the browser/device login flow when prompted.\n" "$new_name"
    set +e
    CODEX_HOME="$dir" "$REAL_CODEX" login
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
      printf "Codex login exited with status %s.\n" "$status" >&2
      printf "Retry later with: boom codex %s -- login\n" "$new_name" >&2
      return "$status"
    fi
    if [ -f "$dir/auth.json" ]; then
      chmod 600 "$dir/auth.json" 2>/dev/null || true
      printf "Codex config '%s' is logged in.\n" "$new_name"
    fi
  fi
}

codex_add() {
  local requested="${1:-}"
  local dir
  local default_profile
  local default_dir=""
  local no_login=0
  local make_default=0
  local status

  [ -n "$requested" ] || die "usage: boom codex add <name> [--default] [--no-login]"
  validate_name "$requested"
  shift || true

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --default)
        make_default=1
        ;;
      --no-login)
        no_login=1
        ;;
      --help|-h)
        printf 'Usage: boom codex add <name> [--default] [--no-login]\n'
        return 0
        ;;
      *)
        die "unknown option for boom codex add: $1"
        ;;
    esac
    shift || true
  done

  dir="$CODEX_PROFILES/$requested"
  [ ! -e "$dir" ] || die "Codex config '$requested' already exists"
  [ -x "$REAL_CODEX" ] || die "real Codex not found: $REAL_CODEX"

  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true

  # 共享 sessions / history / state_5.sqlite，保证 /resume 跨配置可用
  ensure_dir "$CODEX_SHARED/sessions"
  ensure_dir "$CODEX_SHARED/archived_sessions"
  for item in sessions archived_sessions history.jsonl state_5.sqlite; do
    [ -e "$dir/$item" ] || ln -s "$CODEX_SHARED/$item" "$dir/$item"
  done

  default_profile="$(get_default "$CODEX_DEFAULT")"
  if [ -n "$default_profile" ]; then
    default_dir="$(resolve_codex_profile "$default_profile" 2>/dev/null || true)"
  fi

  if [ -n "$default_dir" ] && [ -f "$default_dir/config.toml" ]; then
    cp "$default_dir/config.toml" "$dir/config.toml"
  elif [ -f "$HOME/.codex/config.toml" ]; then
    cp "$HOME/.codex/config.toml" "$dir/config.toml"
  else
    : > "$dir/config.toml"
  fi
  chmod 600 "$dir/config.toml" 2>/dev/null || true

  if [ "$make_default" -eq 1 ] || [ -z "$(get_default "$CODEX_DEFAULT")" ]; then
    set_default_file "$CODEX_DEFAULT" "$requested"
  fi

  printf "Created Codex config '%s': %s\n" "$requested" "$dir"
  if [ "$no_login" -eq 1 ]; then
    printf "Login skipped. Run: boom codex %s -- login\n" "$requested"
    return 0
  fi

  printf "Starting Codex login for '%s'. Finish the browser/device login flow when prompted.\n" "$requested"
  set +e
  CODEX_HOME="$dir" "$REAL_CODEX" login
  status=$?
  set -e

  if [ "$status" -ne 0 ]; then
    printf "Codex login exited with status %s. The config directory was kept.\n" "$status" >&2
    printf "Retry later with: boom codex %s -- login\n" "$requested" >&2
    return "$status"
  fi

  if [ -f "$dir/auth.json" ]; then
    chmod 600 "$dir/auth.json" 2>/dev/null || true
    printf "Codex config '%s' is logged in.\n" "$requested"
  else
    printf "Codex login finished, but auth.json was not found. Check with: boom codex %s -- login status\n" "$requested" >&2
  fi
}

