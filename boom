        const total = cumulativeFrom(info.total_token_usage);
        if (!total) continue;
        d = delta(prevTotal, total);
        prevTotal = total;
      } else if (info.last_token_usage) {
        d = cumulativeFrom(info.last_token_usage);
      }
      if (!d || (d.input === 0 && d.cacheRead === 0 && d.output === 0)) continue;
      rows.push({
        ts: parseTime(value.timestamp),
        model: info.model || currentModel,
        input: d.input,
        output: d.output,
        cacheRead: Math.min(d.cacheRead, d.input),
        cacheCreate: 0,
        calls: 1,
      });
    }
  }
  return { rows, filesScanned: files.length };
}

function geminiRowFromMessage(msg) {
  if (!msg || msg.type !== "gemini" || !msg.tokens || typeof msg.tokens !== "object") return null;
  const input = num(msg.tokens.input);
  const output = num(msg.tokens.output) + num(msg.tokens.thoughts);
  const cacheRead = num(msg.tokens.cached);
  if (input === 0 && output === 0 && cacheRead === 0) return null;
  return {
    ts: parseTime(msg.timestamp),
    model: msg.model || "unknown",
    input,
    output,
    cacheRead,
    cacheCreate: 0,
    calls: 1,
  };
}
function geminiRows() {
  const files = collectGeminiSessions();
  const byMessage = new Map();
  for (const file of files) {
    if (file.endsWith(".jsonl")) {
      for (const line of readLines(file)) {
        if (!line.trim() || !line.includes('"tokens"')) continue;
        const msg = parseJson(line);
        const row = geminiRowFromMessage(msg);
        if (!row) continue;
        const id = msg.id || `${file}:${row.ts}:${byMessage.size}`;
        byMessage.set(`${file}:${id}`, row);
      }
      continue;
    }

    let value = null;
    try { value = JSON.parse(fs.readFileSync(file, "utf8")); } catch { continue; }
    const messages = Array.isArray(value?.messages) ? value.messages : [];
    for (const msg of messages) {
      const row = geminiRowFromMessage(msg);
      if (!row) continue;
      const id = msg.id || `${file}:${row.ts}:${byMessage.size}`;
      byMessage.set(`${file}:${id}`, row);
    }
  }
  return { rows: [...byMessage.values()], filesScanned: files.length };
}

const claude = claudeRows();
printSummary("Claude Usage", claude.rows, claude.filesScanned);
for (const root of codexRoots()) {
  console.log("");
  const codex = codexRowsForRoot(root);
  printSummary(`Codex Usage (${root.label})`, codex.rows, codex.filesScanned);
}
console.log("");
const gemini = geminiRows();
printSummary("Gemini Usage", gemini.rows, gemini.filesScanned);
NODE
}

handle_claude_profile_cmd() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add) claude_add "${1:-}" ;;
    edit) claude_edit "${1:-}" ;;
    show) claude_show "$@" ;;
    list|ls) profile_list claude "$CLAUDE_DEFAULT" ;;
    default) claude_default "${1:-}" ;;
    remove|rm|delete) claude_remove "${1:-}" ;;
    doctor) claude_doctor ;;
    help|--help|-h|"") usage ;;
    *) die "unknown Claude command '$sub'" ;;
  esac
}

handle_codex_profile_cmd() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add) codex_add "$@" ;;
    edit) codex_edit "${1:-}" ;;
    list|ls) profile_list codex "$CODEX_DEFAULT" ;;
    default) codex_default "${1:-}" ;;
    remove|rm|delete) codex_remove "${1:-}" ;;
    doctor) codex_doctor ;;
    help|--help|-h|"") usage ;;
    *) die "unknown Codex command '$sub'" ;;
  esac
}

parse_run_args() {
  PARSED_PROFILE=""
  PARSED_SAFE=0
  PARSED_NO_PROFILE=0
  PARSED_ARGS=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        shift
        PARSED_ARGS+=("$@")
        break
        ;;
      --safe)
        PARSED_SAFE=1
        ;;
      --no-profile)
        PARSED_NO_PROFILE=1
        ;;
      -p|--profile)
        shift
        [ "$#" -gt 0 ] || die "$1 requires a name"
        PARSED_PROFILE="$1"
        ;;
      --profile=*)
        PARSED_PROFILE="${1#--profile=}"
        ;;
      -*)
        PARSED_ARGS+=("$1")
        ;;
      *)
        if [ -z "$PARSED_PROFILE" ]; then
          PARSED_PROFILE="$1"
        else
          PARSED_ARGS+=("$1")
        fi
        ;;
    esac
    shift || true
  done
}

run_claude() {
  local profile="$1"
  local safe="$2"
  local no_profile="$3"
  shift 3
  local args=()
  local profile_path

  [ -x "$REAL_CLAUDE" ] || die "real Claude not found: $REAL_CLAUDE"
  [ "$safe" -eq 1 ] || args+=("--dangerously-skip-permissions")
  args+=("$@")

  if [ "$no_profile" -eq 1 ]; then
    exec "$REAL_CLAUDE" "${args[@]}"
  fi

  if [ -z "$profile" ]; then
    profile="$(get_default "$CLAUDE_DEFAULT")"
  fi

  if [ -z "$profile" ]; then
    exec "$REAL_CLAUDE" "${args[@]}"
  fi

  if ! profile_path="$(resolve_claude_profile "$profile")"; then
    printf "Claude config '%s' does not exist.\n" "$profile" >&2
    print_missing_profiles claude
    exit 1
  fi

  if is_official_claude_profile "$profile_path"; then
    run_claude_with_user_settings_swap "$profile_path" "${args[@]}"
  fi

  run_claude_with_settings "$profile_path" "${args[@]}"
}

run_codex() {
  local profile="$1"
  local safe="$2"
  local no_profile="$3"
  shift 3
  local args=()
  local profile_dir

  [ -x "$REAL_CODEX" ] || die "real Codex not found: $REAL_CODEX"
  [ "$safe" -eq 1 ] || args+=("--dangerously-bypass-approvals-and-sandbox")
  args+=("$@")

  if [ "$no_profile" -eq 1 ]; then
    exec "$REAL_CODEX" "${args[@]}"
  fi

  if [ -z "$profile" ]; then
    profile="$(get_default "$CODEX_DEFAULT")"
  fi

  if [ -z "$profile" ]; then
    exec "$REAL_CODEX" "${args[@]}"
  fi

  if ! profile_dir="$(resolve_codex_profile "$profile")"; then
    printf "Codex config '%s' does not exist.\n" "$profile" >&2
    print_missing_profiles codex
    exit 1
  fi

  CODEX_HOME="$profile_dir" exec "$REAL_CODEX" "${args[@]}"
}

handle_tool() {
  local tool="$1"
  shift || true

  case "${1:-}" in
    profile)
      die "'profile' was removed. Use 'boom c list' or 'boom x list' instead."
      ;;
    help|--help|-h)
      usage
      exit 0
      ;;
  esac

  if [ "$tool" = "claude" ]; then
    case "${1:-}" in
      add|edit|show|list|ls|default|remove|rm|delete|doctor)
        handle_claude_profile_cmd "$@"
        exit $?
        ;;
    esac
  else
    case "${1:-}" in
      add|edit|list|ls|default|remove|rm|delete|doctor)
        handle_codex_profile_cmd "$@"
        exit $?
        ;;
    esac
  fi

  parse_run_args "$@"
  if [ "$tool" = "claude" ]; then
    run_claude "$PARSED_PROFILE" "$PARSED_SAFE" "$PARSED_NO_PROFILE" "${PARSED_ARGS[@]}"
  else
    run_codex "$PARSED_PROFILE" "$PARSED_SAFE" "$PARSED_NO_PROFILE" "${PARSED_ARGS[@]}"
  fi
}

main() {
  ensure_layout
  case "${1:-}" in
    ""|-h|--help|help)
      usage
      ;;
    status)
      shift
      [ "$#" -eq 0 ] || die "usage: boom status"
      qq_status
      ;;
    usage)
      shift
      [ "$#" -eq 0 ] || die "usage: boom usage"
      boom_usage
      ;;
    claude|c)
      shift
      handle_tool claude "$@"
      ;;
    codex|x)
      shift
      handle_tool codex "$@"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
