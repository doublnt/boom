    if (auth.tokens.account_id) headers["ChatGPT-Account-Id"] = auth.tokens.account_id;
    const res = await fetchJson("https://chatgpt.com/backend-api/wham/usage", { headers });
    if (!res.ok || !res.body) {
      fail(`query failed: HTTP ${res.status}`);
      return;
    }
    const rl = res.body.rate_limit;
    const values = [];
    // Window length comes from the API: free/pro plans may expose only a 7-day primary window.
    const windowLabel = (w, fallback) => {
      const secs = Number(w.limit_window_seconds);
      if (!Number.isFinite(secs) || secs <= 0) return fallback;
      if (secs === 604800) return "weekly";
      if (secs % 86400 === 0) return `${secs / 86400}d`;
      if (secs % 3600 === 0) return `${secs / 3600}h`;
      return `${secs / 60}m`;
    };
    for (const [w, fallback] of [[rl?.primary_window, "primary"], [rl?.secondary_window, "secondary"]]) {
      if (!w || !validPercent(w.used_percent)) continue;
      values.push(w.used_percent);
      line(windowLabel(w, fallback), remaining(w.used_percent), w.reset_at);
    }
    if (!values.length) fail("no quota windows returned");
    if (res.body.plan_type) console.log(`  plan: ${paint(res.body.plan_type, "magenta")}`);
    if (rl?.cooldown_active) console.log(`  cooldown: ${paint("active", "yellow")}`);
    if (rl?.limit_reached) console.log(`  limit: ${paint("reached", "red")}`);
    const status = statusForUtilization(values);
    console.log(`  status: ${paint(status, statusColor(status))}`);
  } catch (e) {
    fail(`query failed: ${e.message}`);
  }
}

