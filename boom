    const chats = path.join(base, project.name, "chats");
    for (const entry of readDir(chats)) {
      if (!entry.isFile()) continue;
      if (/^session-.*\.jsonl?$/.test(entry.name)) files.push(path.join(chats, entry.name));
    }
